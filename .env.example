# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Điền API Key của https://trollllm.xyz/ (bắt đầu bằng sk-trollllm-...) vào đây trong bảng Secrets.
OPENAI_API_KEY=""

# OPENAI_BASE_URL: Đường dẫn cổng API chính thức của TrollLLM (https://chat.trollllm.xyz/v1)
OPENAI_BASE_URL="https://chat.trollllm.xyz/v1"

# OPENAI_MODEL: Tên model trên TrollLLM (ví dụ: gpt-6-astra, gpt-6-sol, claude-sonnet-4-6)
OPENAI_MODEL="gpt-6-astra"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
